# Left empty on purpose: the browser calls the SPA's own origin, and Vite's
# dev server proxies /api and /sanctum to the backend behind the scenes
# (see vite.config.ts). Only set this if the browser itself should call a
# different origin directly, bypassing that proxy.
VITE_API_URL=

# Where the Vite dev server (not the browser) reaches the backend to proxy
# to. localhost:8000 works when running `npm run dev` on the host; inside
# Docker this is overridden to the "webserver" service (see
# docker-compose.yml), since "localhost" inside that container isn't the
# host machine.
VITE_API_PROXY_TARGET=http://localhost:8000
