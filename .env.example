# Variables leídas por docker-compose.yml (nivel infraestructura).
# Copia este archivo a ".env" en la raíz del repo y ajusta si lo necesitas.
# Estos valores son solo para entorno local/demo, nunca para producción.

DB_DATABASE=saas_lab
DB_USERNAME=saas_lab
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root_secret

RABBITMQ_USER=saas_lab
RABBITMQ_PASSWORD=secret
